{
  "$defs": {
    "PruneStats": {
      "additionalProperties": false,
      "description": "Overview: retain provenance-pruning counts for reproducible evaluation statistics.",
      "properties": {
        "after_writable_prune": {
          "title": "After Writable Prune",
          "type": "integer"
        },
        "components": {
          "title": "Components",
          "type": "integer"
        },
        "pairs_after": {
          "title": "Pairs After",
          "type": "integer"
        },
        "pairs_before": {
          "title": "Pairs Before",
          "type": "integer"
        },
        "resolve_sites_total": {
          "title": "Resolve Sites Total",
          "type": "integer"
        },
        "truncated_components": {
          "title": "Truncated Components",
          "type": "integer"
        }
      },
      "required": [
        "resolve_sites_total",
        "after_writable_prune",
        "components",
        "pairs_before",
        "pairs_after",
        "truncated_components"
      ],
      "title": "PruneStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Overview: hold mutable run-level metadata and hard-failure accounting fields.",
  "properties": {
    "clock_name": {
      "title": "Clock Name",
      "type": "string"
    },
    "dropped_events": {
      "default": 0,
      "title": "Dropped Events",
      "type": "integer"
    },
    "image_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Digest"
    },
    "kernel_release": {
      "title": "Kernel Release",
      "type": "string"
    },
    "langgraph_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Langgraph Version"
    },
    "memo_hit_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memo Hit Rate"
    },
    "milestone": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6"
      ],
      "title": "Milestone",
      "type": "string"
    },
    "orphan_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orphan Rate"
    },
    "prune": {
      "anyOf": [
        {
          "$ref": "#/$defs/PruneStats"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_wall_ns": {
      "title": "Started Wall Ns",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "started_wall_ns",
    "clock_name",
    "kernel_release",
    "milestone"
  ],
  "title": "RunManifest",
  "type": "object"
}
